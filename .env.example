# PRODUCER.AI — env template. Copy to .env (public_html root) and fill in.
# NEVER commit .env!

# === PostgreSQL (Beget) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=producer_prod
DB_USER=producer_app
DB_PASS=CHANGE_ME
DB_SSLMODE=require

# === JWT (required) ===
JWT_SECRET=CHANGE_SECRET_32_CHARS_MIN
ACCESS_TTL=900
REFRESH_TTL=2592000

# === YandexGPT (briefs, product, leadmagnet, tripwire) ===
YANDEX_GPT_API_KEY=
YC_FOLDER_ID=
YC_MODEL=yandexgpt/latest

# === Yandex Search API / Wordstat (niche analysis) ===
# Either iam token OR api key is enough
YANDEX_SEARCH_IAM_TOKEN=
YANDEX_SEARCH_API_KEY=

# === YooKassa (payments + webhook) ===
# Without them payments.php returns 500, webhook is fail-closed
YOOKASSA_SHOPID=
YOOKASSA_SECRET=
YOOKASSA_RETURN_URL=https://producer-ai.ru/?paid=1

# === CORS (optional, comma-separated) ===
ALLOWED_ORIGINS=https://producer-ai.ru,http://localhost:3000
