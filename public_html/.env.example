# Шаблон .env — скопируйте в .env и заполните реальными значениями.
# Сам .env в репозиторий НЕ коммитить (закрыт в .htaccess и .gitignore).

APP_ENV=production
ALLOWED_ORIGIN=https://producer-ai.ru

DB_HOST=lipikomoufa.beget.app
DB_PORT=5432
DB_NAME=<имя базы>
DB_USER=<пользователь базы>
DB_PASS=<пароль базы>
DB_SSLMODE=require

# openssl rand -hex 32
JWT_SECRET=<64 hex-символа>
ACCESS_TTL=900
REFRESH_TTL=2592000

YC_FOLDER_ID=<folder id из Yandex Cloud>
YANDEX_GPT_API_KEY=<API-ключ сервисного аккаунта>
YC_MODEL=yandexgpt/latest
